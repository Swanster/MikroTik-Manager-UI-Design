# MikroTik Manager — Environment Variables
# Copy this file to .env and fill in your values.

# Vite mode
# VITE_APP_ENV=development

# RouterOS API connection (for production use)
# VITE_ROUTEROS_HOST=192.168.88.1
# VITE_ROUTEROS_PORT=8729
# VITE_ROUTEROS_USERNAME=admin
# VITE_ROUTEROS_PASSWORD=

# Mock API settings
# VITE_MOCK_LATENCY_MIN=80
# VITE_MOCK_LATENCY_MAX=350
# VITE_MOCK_ERROR_RATE=0
# VITE_MOCK_TIMEOUT_RATE=0

# Feature flags
# VITE_ENABLE_FLEET=true
# VITE_ENABLE_BACKUPS=true

# Analytics / monitoring (future)
# VITE_SENTRY_DSN=
